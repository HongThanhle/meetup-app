{
  "expo": {
    "name": "meetup-frontend",
    "slug": "meetup-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "App cần vị trí của bạn để tìm điểm hẹn gần nhất."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ]
  }
}
